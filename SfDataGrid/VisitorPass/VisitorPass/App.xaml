<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VisitorPass"
             xmlns:syncTheme="clr-namespace:Syncfusion.Maui.Themes;assembly=Syncfusion.Maui.Core"
             UserAppTheme="Light"
             x:Class="VisitorPass.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- 1. Syncfusion MaterialLight palette + control brushes.
                        Loaded FIRST so our visitor-pass keys win any clash. -->
                <syncTheme:SyncfusionThemeResourceDictionary VisualTheme="MaterialLight" />

                <!-- 2. Local palette tokens (Primary, Surface, Status
                        Expected/CheckedIn/CheckedOut/Cancelled/Overdue, etc.) -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />

                <!-- 3. Base styles + per-idiom named styles
                        (PagePaddingDesktop / Mobile, SectionSpacingDesktop
                        / Mobile, font sizes, Headline / SubHeadline,
                        default Label / Button / Entry / Page). -->
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />

                <!-- 4. Reusable card / panel / badge styles
                        (KpiCard, PanelCard, ChartPanelCard, SectionTitle,
                        SectionEyebrow, StatusBadgePill, FilterChip,
                        RegisterVisitorPill, Fab). -->
                <ResourceDictionary Source="Resources/Styles/VisitorPassCard.xaml" />

                <!-- 5. Syncfusion palette overrides — MUST be loaded LAST
                        so the SfsPrimary / SfBorderColor / SfsStatus*
                        keys override the MaterialLight defaults from
                        SyncfusionThemeResourceDictionary. -->
                <ResourceDictionary Source="Resources/Styles/VisitorPassTheme.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
