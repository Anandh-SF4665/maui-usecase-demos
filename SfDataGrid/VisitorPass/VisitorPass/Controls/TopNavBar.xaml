<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VisitorPass.Controls;assembly=VisitorPass"
             x:Class="VisitorPass.Controls.TopNavBar">

    <!--
        Top navigation bar (VP-022 + VP-080).

        Used at the top of every screen (Dashboard, Directory,
        Details). Properties:

            Title               (string)  - shown on every idiom
            Subtitle            (string?) - full label on desktop /
                                            tablet; truncated on phone
            ShowRegisterButton  (bool)    - false hides the trigger
                                            entirely. The button shows
                                            in the header on desktop /
                                            tablet; the FAB on phone.
            ShowThemeToggle     (bool)    - false hides the theme
                                            toggle button (default true).
            IsDarkMode          (bool)    - drives the toggle's icon
                                            (sun vs. moon). Set by the
                                            page from ThemeService.

        Raises:
            RegisterClicked    - tapped the Register trigger.
            ThemeToggleClicked - tapped the sun/moon toggle. Page
                                 forwards this to ThemeService.
    -->
    <Grid ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="10"
          Padding="0,0,0,12">

        <VerticalStackLayout Grid.Column="0"
                             Spacing="2"
                             VerticalOptions="Center">
            <Label Text="{Binding Title, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                   FontFamily="OpenSansSemibold"
                   FontSize="22"
                   TextColor="{StaticResource TextPrimary}" />
            <Label Text="{Binding Subtitle, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                   FontFamily="OpenSansRegular"
                   FontSize="11"
                   TextColor="{StaticResource TextSecondary}"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>

        <!-- Theme toggle (sun in dark mode = "switch to light";
             moon in light mode = "switch to dark"). Hidden on phone
             to keep the trigger cluster readable on narrow widths. -->
        <Border Grid.Column="1"
                BackgroundColor="{StaticResource SurfaceAlt}"
                Stroke="{StaticResource Border}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="10,6"
                VerticalOptions="Center"
                IsVisible="{Binding ShowThemeToggle, Source={RelativeSource AncestorType={x:Type ContentView}}}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer x:Name="ThemeTrigger" />
            </Border.GestureRecognizers>
            <Label Text="{Binding ThemeToggleGlyph, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                   FontFamily="OpenSansSemibold"
                   FontSize="14"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
        </Border>

        <!-- Register trigger.
             Desktop / Tablet: header pill (RegisterVisitorPill style).
             Phone: floating action button anchored bottom-right.
             Both raise the same Tapped event handled in code-behind. -->
        <Border Grid.Column="2"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18"
                Padding="14,9"
                VerticalOptions="Center"
                IsVisible="{Binding ShowRegisterButton, Source={RelativeSource AncestorType={x:Type ContentView}}}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer x:Name="HeaderTrigger" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Border BackgroundColor="{StaticResource PrimaryDark}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 11"
                        WidthRequest="22" HeightRequest="22"
                        VerticalOptions="Center">
                    <Label Text="{x:Static controls:IconKeys.Add}"
                           FontFamily="MauiMaterialAssets"
                           TextColor="{StaticResource White}"
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="Register Visitor"
                       TextColor="{StaticResource White}"
                       FontFamily="OpenSansSemibold"
                       FontSize="11"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentView>
