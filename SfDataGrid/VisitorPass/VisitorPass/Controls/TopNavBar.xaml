<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VisitorPass.Controls;assembly=VisitorPass"
             x:Class="VisitorPass.Controls.TopNavBar">

    <Grid ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="16"
          Padding="0,0,0,12">

        <VerticalStackLayout Grid.Column="0"
                             Spacing="0"
                             VerticalOptions="Center">
            <Label Text="{Binding Title, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                   FontFamily="OpenSansSemibold"
                   FontSize="22"
                   TextColor="{StaticResource TextPrimary}" />
            <Label Text="{Binding Subtitle, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                   FontFamily="OpenSansRegular"
                   FontSize="11"
                   TextColor="{StaticResource TextSecondary}"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>

        <Grid Grid.Column="1"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              ColumnSpacing="12"
              VerticalOptions="Center">

            <Border Grid.Column="0"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    Padding="14,8"
                    StrokeShape="RoundRectangle 14"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <BoxView WidthRequest="10" HeightRequest="10" Color="{StaticResource StatusCheckedIn}" VerticalOptions="Center" />
                    <Label Text="Central Office"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                    <Label Text="⌄"
                           FontFamily="OpenSansRegular"
                           FontSize="12"
                           TextColor="{StaticResource TextMuted}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Grid.Column="1"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    Padding="14,8"
                    StrokeShape="RoundRectangle 14"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{x:Static controls:IconKeys.Event}"
                           FontFamily="MauiMaterialAssets"
                           FontSize="14"
                           TextColor="{StaticResource TextMuted}"
                           VerticalOptions="Center" />
                    <Label Text="Thursday, Oct 24, 2024"
                           FontFamily="OpenSansSemibold"
                           FontSize="14"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Grid.Column="2"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    Padding="12,7"
                    StrokeShape="RoundRectangle 14"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="{x:Static controls:IconKeys.Search}"
                           FontFamily="MauiMaterialAssets"
                           FontSize="14"
                           TextColor="{StaticResource TextMuted}"
                           VerticalOptions="Center" />
                    <controls:SfEntry Placeholder="Quick search badges, guests (Ctrl+K)"
                                      Text="{Binding SearchText}"
                                      FontFamily="OpenSansRegular"
                                      FontSize="13"
                                      TextColor="{StaticResource TextPrimary}"
                                      PlaceholderColor="{StaticResource TextMuted}"
                                      HorizontalOptions="FillAndExpand"
                                      BackgroundColor="Transparent"
                                      VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>

            <Grid Grid.Column="3" />

            <Grid Grid.Column="4"
                  ColumnDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Center">
                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Label Text="{x:Static controls:IconKeys.Notifications}"
                           FontFamily="MauiMaterialAssets"
                           FontSize="20"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Border WidthRequest="8"
                            HeightRequest="8"
                            BackgroundColor="{StaticResource StatusCancelled}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 4"
                            HorizontalOptions="End"
                            VerticalOptions="Start" />
                </Grid>

                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="10"
                                       VerticalOptions="Center">
                    <VerticalStackLayout Spacing="0"
                                         VerticalOptions="Center"
                                         HorizontalOptions="End">
                        <Label Text="Sarah Jenkins"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalTextAlignment="End" />
                        <Label Text="Facility Admin"
                               FontFamily="OpenSansRegular"
                               FontSize="11"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="End" />
                    </VerticalStackLayout>

                    <Border WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20">
                        <Label Text="SJ"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentView>