<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VisitorPass.Controls;assembly=VisitorPass"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             x:Class="VisitorPass.Controls.TopNavBar">
    
    <Grid ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="10"
          Padding="0,0,0,12">

        <VerticalStackLayout Grid.Column="0"
                             Spacing="2"
                             VerticalOptions="Center">
            <Label Text="{Binding Title, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                   FontFamily="OpenSansSemibold"
                   FontSize="22"
                   TextColor="{StaticResource TextPrimary}" />
            <Label Text="{Binding Subtitle, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                   FontFamily="OpenSansRegular"
                   FontSize="11"
                   TextColor="{StaticResource TextSecondary}"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>

        <Grid HeightRequest="72"
      Padding="20,12"
      ColumnSpacing="16"
      ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">

            <!-- Title -->
            <Label Grid.Column="0"
           Text="Visitor Command Center"
           FontSize="20"
           FontAttributes="Bold"
           TextColor="#1E293B"
           VerticalOptions="Center"/>

            <!-- Separator -->
            <BoxView Grid.Column="0"
             HorizontalOptions="End"
             WidthRequest="1"
             HeightRequest="24"
             Color="#E5E7EB"
             Margin="20,0,-8,0"
             VerticalOptions="Center"/>

            <!-- Office -->
            <Border Grid.Column="1"
            BackgroundColor="#F8FAFC"
            Stroke="#E2E8F0"
            Padding="14,8"
            StrokeShape="RoundRectangle 12">

                <HorizontalStackLayout Spacing="8">

                    <Ellipse WidthRequest="10"
                     HeightRequest="10"
                     Fill="#22C55E"
                     VerticalOptions="Center"/>

                    <Label Text="Central Office"
                   FontSize="14"
                   TextColor="#334155"
                   VerticalOptions="Center"/>

                    <Label Text="⌄"
                   FontSize="14"
                   TextColor="#64748B"
                   VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Date -->
            <Border Grid.Column="2"
            BackgroundColor="#F8FAFC"
            Stroke="#E2E8F0"
            Padding="14,8"
            StrokeShape="RoundRectangle 12">

                <HorizontalStackLayout Spacing="8">

                    <Label Text="📅"
                   FontSize="14"/>

                    <Label Text="Thursday, Oct 24, 2024"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#475569"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Search -->
            <syncfusion:SfTextInputLayout Grid.Column="3"
                                  ContainerType="Outlined"
                                  HeightRequest="44"
                                  Hint="Quick search badges, guests">

                <syncfusion:SfTextInputLayout.LeadingView>
                    <Label Text="⌕"
                   FontSize="16"
                   VerticalTextAlignment="Center"/>
                </syncfusion:SfTextInputLayout.LeadingView>

                <Entry Placeholder="Quick search badges, guests"
               FontSize="14"/>
            </syncfusion:SfTextInputLayout>

            <!-- Notification -->
            <Grid Grid.Column="4"
          WidthRequest="40"
          HeightRequest="40">

                <Label Text="🔔"
               FontSize="20"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>

                <Border WidthRequest="10"
                HeightRequest="10"
                BackgroundColor="#EF4444"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 5"
                HorizontalOptions="End"
                VerticalOptions="Start"/>
            </Grid>

            <!-- User -->
            <HorizontalStackLayout Grid.Column="5"
                           Spacing="12">

                <VerticalStackLayout Spacing="0"
                             VerticalOptions="Center">

                    <Label Text="Sarah Jenkins"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="End"/>

                    <Label Text="Facility Admin"
                   FontSize="12"
                   TextColor="#64748B"
                   HorizontalTextAlignment="End"/>
                </VerticalStackLayout>

                <Border WidthRequest="42"
                HeightRequest="42"
                BackgroundColor="#2563EB"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 21">

                    <Label Text="👤"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
                </Border>

            </HorizontalStackLayout>

        </Grid>
        
        
    </Grid>
</ContentView>