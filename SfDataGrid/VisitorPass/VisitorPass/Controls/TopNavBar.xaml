<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VisitorPass.Controls.TopNavBar">

    <!--
        Top navigation bar (VP-022).

        Used at the top of every screen (Dashboard, Directory,
        Details). Three properties:

            Title               (string) - shown on every idiom
            Subtitle            (string?) - full label on desktop /
                                           tablet; truncated on phone
            ShowRegisterButton  (bool)   - false hides the trigger
                                           entirely. The button shows
                                           in the header on desktop /
                                           tablet; the FAB on phone.

        Raises RegisterClicked when the user taps the trigger.
        The page's code-behind wires that event to
        Navigation.PushModalAsync(new NavigationPage(new RegisterVisitorPage()))
        on phone or to SfPopup.IsOpen = true on desktop (see VP-073).
    -->
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="12"
          Padding="0,0,0,12">

        <VerticalStackLayout Grid.Column="0"
                             Spacing="2"
                             VerticalOptions="Center">
            <Label Text="{Binding Title, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                   FontFamily="OpenSansSemibold"
                   FontSize="22"
                   TextColor="{StaticResource TextPrimary}" />
            <Label Text="{Binding Subtitle, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                   FontFamily="OpenSansRegular"
                   FontSize="11"
                   TextColor="{StaticResource TextSecondary}"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>

        <!-- Register trigger.
             Desktop / Tablet: header pill (RegisterVisitorPill style).
             Phone: floating action button anchored bottom-right.
             Both raise the same Tapped event handled in code-behind. -->
        <Border Grid.Column="1"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18"
                Padding="14,9"
                VerticalOptions="Center"
                IsVisible="{Binding ShowRegisterButton, Source={RelativeSource AncestorType={x:Type ContentView}}}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer x:Name="HeaderTrigger" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Border BackgroundColor="{StaticResource PrimaryDark}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 11"
                        WidthRequest="22" HeightRequest="22"
                        VerticalOptions="Center">
                    <Label Text="+"
                           TextColor="{StaticResource White}"
                           FontFamily="OpenSansSemibold"
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="Register Visitor"
                       TextColor="{StaticResource White}"
                       FontFamily="OpenSansSemibold"
                       FontSize="11"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentView>
