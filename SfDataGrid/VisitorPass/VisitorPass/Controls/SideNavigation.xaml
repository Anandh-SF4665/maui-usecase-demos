<?xml version="1.0" encoding="UTF-8" ?>
<!--
    SideNavigation - vertical nav rail injected into every page
    on desktop / tablet idioms (hidden on phone per HARNESS §7
    OnIdiom rule).

    Layout (top to bottom):
      1. Brand block - rounded icon tile + "Visitor Pass" / sub-label
      2. "NAVIGATION" eyebrow
      3. Two nav items: Command Center + Visitor Directory.
         The active item is highlighted via the Bindable
         ActiveRoute property; visual states are switched via
         DataTriggers on each tile so the code-behind doesn't
         need to walk the visual tree.
      4. Footer status indicator ("MAUI Runtime v4.2.0").
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VisitorPass.Controls.SideNavigation"
             x:Name="Root">

    <Border BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource Border}"
            StrokeThickness="0"
            Padding="14,18,14,18">

        <Grid RowSpacing="14"
              RowDefinitions="Auto,Auto,*,Auto">

            <!-- ==================================================
                 1. Brand block
                 ================================================== -->
            <HorizontalStackLayout Grid.Row="0" Spacing="10">
                <Border BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        WidthRequest="32"
                        HeightRequest="32"
                        VerticalOptions="Center">
                    <Label Text="&#x1F6E1;"
                           FontSize="14"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label Text="Visitor Pass"
                           FontFamily="OpenSansSemibold"
                           FontSize="13"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Enterprise OS"
                           FontFamily="OpenSansRegular"
                           FontSize="9"
                           TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- ==================================================
                 2. NAVIGATION eyebrow
                 ================================================== -->
            <Label Grid.Row="1"
                   Text="NAVIGATION"
                   FontFamily="OpenSansSemibold"
                   FontSize="9"
                   CharacterSpacing="2"
                   Margin="2,8,0,0"
                   TextColor="{StaticResource TextMuted}" />

            <!-- ==================================================
                 3. Nav items - Command Center + Visitor Directory.
                 Each tile's BackgroundColor + the inner label's
                 font / colour flip via DataTriggers keyed off
                 the Bindable ActiveRoute property.
                 ================================================== -->
            <VerticalStackLayout Grid.Row="2" Spacing="4">

                <!-- Command Center tile -->
                <Border BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,10">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding ActiveRoute, Source={x:Reference Root}}"
                                     Value="directory">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCommandCenterTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 5"
                                WidthRequest="22"
                                HeightRequest="22"
                                VerticalOptions="Center">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ActiveRoute, Source={x:Reference Root}}"
                                             Value="dashboard">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ActiveRoute, Source={x:Reference Root}}"
                                             Value="directory">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
                                    <Setter Property="Stroke" Value="{StaticResource Border}" />
                                    <Setter Property="StrokeThickness" Value="1" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="&#x25A6;"
                                   FontSize="12"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding ActiveRoute, Source={x:Reference Root}}"
                                                 Value="directory">
                                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Label Text="Command Center"
                               FontFamily="OpenSansSemibold"
                               FontSize="12"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding ActiveRoute, Source={x:Reference Root}}"
                                             Value="directory">
                                    <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                    <Setter Property="FontFamily" Value="OpenSansRegular" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <!-- Visitor Directory tile -->
                <Border BackgroundColor="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,10">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding ActiveRoute, Source={x:Reference Root}}"
                                     Value="directory">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDirectoryTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 5"
                                WidthRequest="22"
                                HeightRequest="22"
                                VerticalOptions="Center">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ActiveRoute, Source={x:Reference Root}}"
                                             Value="dashboard">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
                                    <Setter Property="Stroke" Value="{StaticResource Border}" />
                                    <Setter Property="StrokeThickness" Value="1" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ActiveRoute, Source={x:Reference Root}}"
                                             Value="directory">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="&#x25A2;"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding ActiveRoute, Source={x:Reference Root}}"
                                                 Value="directory">
                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Label Text="Visitor Directory"
                               FontFamily="OpenSansRegular"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding ActiveRoute, Source={x:Reference Root}}"
                                             Value="directory">
                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                    <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- ==================================================
                 4. Footer - MAUI Runtime version
                 ================================================== -->
            <HorizontalStackLayout Grid.Row="3" Spacing="6">
                <Ellipse WidthRequest="6" HeightRequest="6"
                         Fill="{StaticResource StatusCheckedInBrush}"
                         VerticalOptions="Center" />
                <Label Text="MAUI Runtime"
                       FontFamily="OpenSansRegular"
                       FontSize="9"
                       TextColor="{StaticResource TextMuted}"
                       VerticalOptions="Center" />
                <Label Text="v4.2.0"
                       FontFamily="OpenSansRegular"
                       FontSize="9"
                       TextColor="{StaticResource TextMuted}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

        </Grid>
    </Border>
</ContentView>
