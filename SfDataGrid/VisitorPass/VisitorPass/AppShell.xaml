<?xml version="1.0" encoding="UTF-8" ?>
<!--
    VP-030 — single AppShell hosting the three screens.

    Per HARNESS §6 rule 4 (single page, two form factors) and
    HARNESS §11 (no MobileShell / DesktopShell split), this Shell is
    the ONLY root surface in the app:

      - FlyoutBehavior=Disabled — no sidebar navigation; the in-page
        TopNavBar drives linear forward/back navigation between the
        three screens.
      - NavBarIsVisible=False    — the platform navigation bar is
        suppressed; every page hosts its own TopNavBar control from
        VP-022.

    Three ShellContent entries declare the canonical routes:

      "dashboard" -> Views/DashboardPage    (Visitor Command Center)
      "directory" -> Views/DirectoryPage    (Visitor Directory)
      "details"   -> Views/VisitorDetailsPage (Digital Pass & Visit Details)

    Phases 4-6 fill in the body of each page; the routes, types and
    registrations stay stable from here on.

    Note: ShellContent's ContentTemplate inflates pages via the DI
    container. The pages receive their view-models through constructor
    injection (registered as singletons in MauiProgram.cs).
-->
<Shell
    x:Class="VisitorPass.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:VisitorPass.Views;assembly=VisitorPass"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="Visitor Pass">

    <ShellContent
        Title="Visitor Command Center"
        Route="dashboard"
        ContentTemplate="{DataTemplate views:DashboardPage}" />

    <ShellContent
        Title="Visitor Directory"
        Route="directory"
        ContentTemplate="{DataTemplate views:DirectoryPage}" />

    <ShellContent
        Title="Digital Pass"
        Route="details"
        ContentTemplate="{DataTemplate views:VisitorDetailsPage}" />

</Shell>
