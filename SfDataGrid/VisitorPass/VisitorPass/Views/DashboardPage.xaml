<?xml version="1.0" encoding="utf-8" ?>
<!--
    Phase 4 — Dashboard (Screen 1, single page).

    Single ContentPage hosts everything the Visitor Command Center
    shows. Per HARNESS §7, every layout difference between desktop
    and mobile is expressed inside the same XAML via OnIdiom.

    Sidebar wrapper: the root is now a 2-column Grid. Column 0
    hosts the SideNavigation control (hidden on phone via
    OnIdiom Phone=False, Default=True). Column 1 is the existing
    ScrollView body. This matches the expected UI which shows a
    persistent left rail on desktop / tablet.

    Section 1 — KPI grid: ColumnDefinitions use OnIdiom four-col
    on desktop / tablet, two-col on phone.
    Section 2 + 3 — chart panels: side-by-side on desktop / tablet,
    stacked on phone.
    Section 4 — today's activity grid: Pass ID hides on phone.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VisitorPass.ViewModels;assembly=VisitorPass"
             xmlns:models="clr-namespace:VisitorPass.Models;assembly=VisitorPass"
             xmlns:controls="clr-namespace:VisitorPass.Controls;assembly=VisitorPass"
             xmlns:views="clr-namespace:VisitorPass.Views;assembly=VisitorPass"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:sfgrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:sfpopup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             x:Class="VisitorPass.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Visitor Command Center"
             BackgroundColor="{StaticResource SurfaceAlt}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <sfgrid:DataGridStyle x:Key="TodayGridStyle"
                                  RowBackground="{StaticResource Surface}"
                                  AlternateRowBackground="{StaticResource SurfaceAlt}"
                                  HeaderRowBackground="{StaticResource PrimaryLight}"
                                  HeaderRowTextColor="{StaticResource TextPrimary}"
                                  HeaderRowFontSize="11"
                                  HeaderRowFontFamily="OpenSansSemibold"
                                  RowTextColor="{StaticResource TextPrimary}"
                                  RowFontSize="11"
                                  RowFontFamily="OpenSansRegular"
                                  GridLineColor="{StaticResource Border}"
                                  GridLineStrokeThickness="0.5" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--
        Root overlay Grid: the 2-column layout (sidebar + content)
        sits in row 0; the SfPopup for the registration surface
        overlays the whole page in row 1 so it covers both the
        sidebar and the content when open.
    -->
    <Grid>

    <!--
        2-column layout: sidebar on the left (desktop / tablet
        only), content on the right (always). On phone the sidebar
        column collapses to 0 width and the content fills the page.
    -->
    <Grid ColumnDefinitions="{OnIdiom Desktop='232,*', Phone='0,*'}"
          ColumnSpacing="0">

        <!-- ============================================
             Sidebar (desktop / tablet only)
             ============================================ -->
        <controls:SideNavigation Grid.Column="0"
                                ActiveRoute="dashboard"
                                IsVisible="{OnIdiom Phone=False, Default=True}" />

        <!-- ============================================
             Content area (always visible)
             ============================================ -->
        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="{OnIdiom Desktop='24,0,24,28', Phone='14,8,14,14'}"
                                 Spacing="{OnIdiom Desktop=18, Phone=14}">

                <controls:TopNavBar Title="Visitor Command Center"
                                    Subtitle="Real-time visitor activity overview"
                                    ShowRegisterButton="True" />

                <!-- ============== Section 1 — KPI grid ============== -->
                <Grid ColumnDefinitions="{OnIdiom Desktop='*,*,*,*', Phone='*,*'}"
                      ColumnSpacing="14"
                      RowSpacing="14">

                    <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{x:Static controls:IconKeys.Schedule}"
                                       FontFamily="MauiMaterialAssets"
                                       FontSize="13"
                                       TextColor="{StaticResource StatusExpected}"
                                       VerticalOptions="Center" />
                                <Label Text="EXPECTED VISITORS"
                                       Style="{StaticResource SectionEyebrow}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Stats.ExpectedVisitors}"
                                   Style="{StaticResource KpiValue}"
                                   TextColor="{StaticResource StatusExpectedBrush}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="{OnIdiom Desktop=1, Phone=1}" Style="{StaticResource KpiCard}">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{x:Static controls:IconKeys.Verified}"
                                       FontFamily="MauiMaterialAssets"
                                       FontSize="13"
                                       TextColor="{StaticResource StatusCheckedIn}"
                                       VerticalOptions="Center" />
                                <Label Text="CHECKED IN"
                                       Style="{StaticResource SectionEyebrow}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Stats.CheckedIn}"
                                   Style="{StaticResource KpiValue}"
                                   TextColor="{StaticResource StatusCheckedInBrush}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="{OnIdiom Desktop=2, Phone=0}" Style="{StaticResource KpiCard}">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{x:Static controls:IconKeys.EventAvailable}"
                                       FontFamily="MauiMaterialAssets"
                                       FontSize="13"
                                       TextColor="{StaticResource StatusCheckedOut}"
                                       VerticalOptions="Center" />
                                <Label Text="CHECKED OUT"
                                       Style="{StaticResource SectionEyebrow}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Stats.CheckedOut}"
                                   Style="{StaticResource KpiValue}"
                                   TextColor="{StaticResource StatusCheckedOutBrush}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="{OnIdiom Desktop=3, Phone=0}" Style="{StaticResource KpiCard}">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse WidthRequest="8" HeightRequest="8"
                                         Fill="{StaticResource StatusOverdueBrush}"
                                         VerticalOptions="Center" />
                                <Label Text="OVERDUE"
                                       Style="{StaticResource SectionEyebrow}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Stats.OverdueVisitors}"
                                   Style="{StaticResource KpiValue}"
                                   TextColor="{StaticResource StatusOverdueBrush}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ============== Section 2 + 3 — charts ============== -->
                <Grid ColumnDefinitions="{OnIdiom Desktop='*,*', Phone='*'}"
                      RowDefinitions="{OnIdiom Desktop='Auto', Phone='Auto,Auto'}"
                      ColumnSpacing="14"
                      RowSpacing="14">

                    <!-- Donut: Visitor Status Distribution -->
                    <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource ChartPanelCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="VISITOR STATUS DISTRIBUTION"
                                   Style="{StaticResource SectionEyebrow}" />
                            <chart:SfCircularChart HeightRequest="320">
                                <chart:SfCircularChart.Legend>
                                    <chart:ChartLegend Placement="Top" />
                                </chart:SfCircularChart.Legend>
                                <chart:SfCircularChart.Series>
                                    <chart:DoughnutSeries ItemsSource="{Binding StatusBreakdown}"
                                                          XBindingPath="Label"
                                                          YBindingPath="Count"
                                                          InnerRadius="0.55" />
                                </chart:SfCircularChart.Series>
                            </chart:SfCircularChart>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Column: Visits by Purpose -->
                    <Border Grid.Column="{OnIdiom Desktop=1, Phone=0}"
                            Grid.Row="{OnIdiom Desktop=0, Phone=1}"
                            Style="{StaticResource ChartPanelCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="VISITS BY PURPOSE"
                                   Style="{StaticResource SectionEyebrow}" />
                            <chart:SfCartesianChart HeightRequest="320">
                                <chart:SfCartesianChart.PaletteBrushes>
                                    <SolidColorBrush Color="#0050CB" />
                                </chart:SfCartesianChart.PaletteBrushes>
                                <chart:SfCartesianChart.XAxes>
                                    <chart:CategoryAxis />
                                </chart:SfCartesianChart.XAxes>
                                <chart:SfCartesianChart.YAxes>
                                    <chart:NumericalAxis />
                                </chart:SfCartesianChart.YAxes>
                                <chart:SfCartesianChart.Series>
                                    <chart:ColumnSeries ItemsSource="{Binding PurposeBreakdown}"
                                                        XBindingPath="Label"
                                                        YBindingPath="Count" />
                                </chart:SfCartesianChart.Series>
                            </chart:SfCartesianChart>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ============== Section 4 — Today's activity grid ============== -->
                <Border Style="{StaticResource PanelCard}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="TODAY'S ACTIVITY"
                                   Style="{StaticResource SectionEyebrow}" />
                            <Label Grid.Column="1"
                                   Text="{Binding TodayVisitorsCount, StringFormat='{0} visitors today'}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="11"
                                   TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <sfgrid:SfDataGrid x:Name="TodayGrid"
                                           ItemsSource="{Binding TodayVisitors}"
                                           SelectionMode="Single"
                                           ColumnWidthMode="Auto"
                                           HeaderRowHeight="38"
                                           RowHeight="58"
                                           Style="{StaticResource TodayGridStyle}"
                                           CellTapped="OnTodayGridCellTapped">

                            <sfgrid:SfDataGrid.Columns>
                                <sfgrid:DataGridTemplateColumn HeaderText="PASS ID"
                                                              MappingName="PassId"
                                                              Width="110"
                                                              Visible="{OnIdiom Phone=False, Default=True}">
                                    <sfgrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Visitor">
                                            <Label Text="{Binding PassId}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   VerticalOptions="Center"
                                                   Margin="14,0,0,0" />
                                        </DataTemplate>
                                    </sfgrid:DataGridTemplateColumn.CellTemplate>
                                </sfgrid:DataGridTemplateColumn>

                                <sfgrid:DataGridTemplateColumn HeaderText="VISITOR"
                                                              MappingName="VisitorName"
                                                              Width="160">
                                    <sfgrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Visitor">
                                            <Label Text="{Binding VisitorName}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   VerticalOptions="Center" />
                                        </DataTemplate>
                                    </sfgrid:DataGridTemplateColumn.CellTemplate>
                                </sfgrid:DataGridTemplateColumn>

                                <sfgrid:DataGridTemplateColumn HeaderText="HOST"
                                                              MappingName="Host"
                                                              Width="140">
                                    <sfgrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Visitor">
                                            <Label Text="{Binding Host}"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   VerticalOptions="Center" />
                                        </DataTemplate>
                                    </sfgrid:DataGridTemplateColumn.CellTemplate>
                                </sfgrid:DataGridTemplateColumn>

                                <sfgrid:DataGridTemplateColumn HeaderText="PURPOSE"
                                                              MappingName="Purpose"
                                                              Width="140">
                                    <sfgrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Visitor">
                                            <Label Text="{Binding Purpose}"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   VerticalOptions="Center" />
                                        </DataTemplate>
                                    </sfgrid:DataGridTemplateColumn.CellTemplate>
                                </sfgrid:DataGridTemplateColumn>

                                <sfgrid:DataGridTemplateColumn HeaderText="TIME"
                                                              MappingName="VisitTime"
                                                              Width="100">
                                    <sfgrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Visitor">
                                            <Label Text="{Binding VisitTime, StringFormat='{0:hh\\:mm}'}"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   VerticalOptions="Center" />
                                        </DataTemplate>
                                    </sfgrid:DataGridTemplateColumn.CellTemplate>
                                </sfgrid:DataGridTemplateColumn>

                                <sfgrid:DataGridTemplateColumn HeaderText="STATUS"
                                                              MappingName="Status"
                                                              Width="130">
                                    <sfgrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Visitor">
                                            <controls:VisitorStatusBadge Status="{Binding Status}"
                                                                       VerticalOptions="Center" />
                                        </DataTemplate>
                                    </sfgrid:DataGridTemplateColumn.CellTemplate>
                                </sfgrid:DataGridTemplateColumn>
                            </sfgrid:SfDataGrid.Columns>
                        </sfgrid:SfDataGrid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

    <!-- ==================================================
         VP-UI popup — registration surface.
         Hosts RegisterVisitorView directly inside the popup
         body via ContentTemplate. Triggered from
         OnRegisterClicked in code-behind; the Opened event
         handler resolves a fresh RegisterVisitorViewModel from
         DI, sets it as the popup's BindingContext, then walks the
         PopupView's visual tree to find the inflated
         RegisterVisitorView and binds the same VM to it. The
         view's lifecycle events (DismissRequested /
         PassGenerated) are wired on the inflated view so
         dismiss/pass navigate correctly.
         ================================================== -->
    <sfpopup:SfPopup x:Name="RegisterPopup"
                     ShowHeader="False"
                     ShowFooter="False"
                     ShowCloseButton="True"
                     Opened="OnRegisterPopupOpened"
                     WidthRequest="{OnIdiom Desktop=640, Phone=340}"
                     HeightRequest="{OnIdiom Desktop=640, Phone=560}">
        <sfpopup:SfPopup.PopupStyle>
            <sfpopup:PopupStyle StrokeThickness="0"
                                CornerRadius="{OnIdiom Default=16, Phone=24}" />
        </sfpopup:SfPopup.PopupStyle>
        <sfpopup:SfPopup.ContentTemplate>
            <DataTemplate>
                <views:RegisterVisitorView />
            </DataTemplate>
        </sfpopup:SfPopup.ContentTemplate>
    </sfpopup:SfPopup>

    </Grid>
</ContentPage>