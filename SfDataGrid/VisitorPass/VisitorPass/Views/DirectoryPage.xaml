<?xml version="1.0" encoding="utf-8" ?>
<!--
    Phase 5 — Directory (Screen 2, single page).

    Hosts everything the Directory screen shows in one ContentPage:
    TopNavBar (no Register trigger — Dashboard owns that), a live
    search Entry, a horizontal CollectionView of status filter chips
    (Border-based, using the VP-003 FilterChip style), the visitor
    SfDataGrid, and an EmptyState placeholder for "no matches".

    Per HARNESS §7, layout differences between desktop / tablet and
    phone are expressed via OnIdiom — never via parallel DesktopUI /
    MobileUI folders.

    Why a CollectionView of Borders instead of SfChipGroup:
      The Syncfusion toolkit ships SfChipGroup but the
      SfChipStyles class doesn't expose visual setters in this
      release. The VP-003 FilterChip Border style is already wired
      into the theme palette and matches the in-repo reference
      patterns; using it here keeps one styling model across the
      whole app.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VisitorPass.ViewModels;assembly=VisitorPass"
             xmlns:models="clr-namespace:VisitorPass.Models;assembly=VisitorPass"
             xmlns:controls="clr-namespace:VisitorPass.Controls;assembly=VisitorPass"
             xmlns:sfgrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:barcode="clr-namespace:Syncfusion.Maui.Barcode;assembly=Syncfusion.Maui.Barcode"
             x:Class="VisitorPass.Views.DirectoryPage"
             x:DataType="vm:DirectoryViewModel"
             Title="Visitor Directory"
             BackgroundColor="{StaticResource SurfaceAlt}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!--
                Directory DataGrid style — slightly heavier header
                and row height than TodayGridStyle because the
                directory's avatar + name + contact template needs
                more vertical room than the dashboard's compact cells.
            -->
            <sfgrid:DataGridStyle x:Key="DirectoryGridStyle"
                                  RowBackground="{StaticResource Surface}"
                                  AlternateRowBackground="{StaticResource SurfaceAlt}"
                                  HeaderRowBackground="{StaticResource SurfaceAlt}"
                                  HeaderRowTextColor="{StaticResource TextMuted}"
                                  HeaderRowFontSize="10"
                                  HeaderRowFontFamily="OpenSansSemibold"
                                  RowTextColor="{StaticResource TextPrimary}"
                                  RowFontSize="11"
                                  RowFontFamily="OpenSansRegular"
                                  GridLineColor="{StaticResource Border}"
                                  GridLineStrokeThickness="0.5" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--
        Root 2-column Grid: sidebar on the left (desktop / tablet
        only), content on the right. Same idiom-switched
        ColumnDefinitions as the Dashboard page.
    -->
    <Grid ColumnDefinitions="{OnIdiom Desktop='232,*', Phone='0,*'}"
          ColumnSpacing="0">

        <!-- Sidebar (desktop / tablet only) -->
        <controls:SideNavigation Grid.Column="0"
                                ActiveRoute="directory"
                                IsVisible="{OnIdiom Phone=False, Default=True}" />

        <!-- Content (always visible) -->
        <Grid Grid.Column="1"
              Padding="{OnIdiom Desktop='24,0,24,24', Phone='14,8,14,14'}"
              RowSpacing="14"
              RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- ============================== -->
        <!-- 1. TopNavBar (no register)     -->
        <!-- ============================== -->
        <controls:TopNavBar Grid.Row="0"
                            Title="Visitor Directory"
                            Subtitle="Search and filter every visit"
                            ShowRegisterButton="False" />

        <!-- ============================== -->
        <!-- 2. Directory summary and search -->
        <!-- ============================== -->
        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Visitor Directory"
                               FontFamily="OpenSansSemibold"
                               FontSize="22"
                               TextColor="{StaticResource TextPrimary}" />
                        <Border BackgroundColor="{StaticResource PrimaryLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="9,4"
                                VerticalOptions="Center">
                            <Label Text="{Binding FilteredVisitors.Count, StringFormat='{0} Records'}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="10"
                                   TextColor="{StaticResource Primary}" />
                        </Border>
                    </HorizontalStackLayout>
                    <Label Text="Search and filter every visit"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,9"
                        IsVisible="{OnIdiom Phone=False, Default=True}"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterVisitor" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{x:Static controls:IconKeys.Add}"
                               FontFamily="MauiMaterialAssets"
                               FontSize="14"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center" />
                        <Label Text="Register Visitor"
                               FontFamily="OpenSansSemibold"
                               FontSize="11"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="{OnIdiom Desktop='*,*,*,*', Phone='*,*'}"
                  RowDefinitions="{OnIdiom Desktop='Auto', Phone='Auto,Auto'}"
                  ColumnSpacing="8" RowSpacing="8">
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 12" Padding="12,9">
                    <VerticalStackLayout Spacing="2"><Label Text="TOTAL RECORDS" Style="{StaticResource SectionEyebrow}" /><Label Text="{Binding TotalVisitors}" Style="{StaticResource KpiValue}" FontSize="18" /></VerticalStackLayout>
                </Border>
                <Border Grid.Row="{OnIdiom Desktop=0, Phone=0}" Grid.Column="{OnIdiom Desktop=1, Phone=1}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 12" Padding="12,9">
                    <VerticalStackLayout Spacing="2"><Label Text="EXPECTED" Style="{StaticResource SectionEyebrow}" /><Label Text="{Binding ExpectedVisitors}" Style="{StaticResource KpiValue}" FontSize="18" TextColor="{StaticResource StatusExpected}" /></VerticalStackLayout>
                </Border>
                <Border Grid.Row="{OnIdiom Desktop=0, Phone=1}" Grid.Column="{OnIdiom Desktop=2, Phone=0}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 12" Padding="12,9">
                    <VerticalStackLayout Spacing="2"><Label Text="CHECKED IN" Style="{StaticResource SectionEyebrow}" /><Label Text="{Binding CheckedInVisitors}" Style="{StaticResource KpiValue}" FontSize="18" TextColor="{StaticResource StatusCheckedIn}" /></VerticalStackLayout>
                </Border>
                <Border Grid.Row="{OnIdiom Desktop=0, Phone=1}" Grid.Column="{OnIdiom Desktop=3, Phone=1}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 12" Padding="12,9">
                    <VerticalStackLayout Spacing="2"><Label Text="OVERDUE" Style="{StaticResource SectionEyebrow}" /><Label Text="{Binding OverdueVisitors}" Style="{StaticResource KpiValue}" FontSize="18" TextColor="{StaticResource StatusOverdue}" /></VerticalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="{StaticResource Surface}"
                    StrokeThickness="1"
                    Stroke="{StaticResource Border}"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,0"
                    HeightRequest="48">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <!-- Search glyph (Material Icons font). VP-104. -->
                <Label Grid.Column="0"
                       Text="{x:Static controls:IconKeys.Search}"
                       FontFamily="MauiMaterialAssets"
                       FontSize="14"
                       TextColor="{StaticResource TextMuted}"
                       VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Placeholder="Search by name, host, or pass id..."
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="{StaticResource TextPrimary}"
                       BackgroundColor="Transparent"
                       FontSize="13"
                       FontFamily="OpenSansRegular"
                       Text="{Binding SearchText, Mode=TwoWay}" />
            </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- ============================== -->
        <!-- 3. Status filter chips         -->
        <!--    Horizontal CollectionView   -->
        <!--    of FilterChip Borders.      -->
        <!--    Selection toggled via       -->
        <!--    SelectStatusCommand.        -->
        <!-- ============================== -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding StatusFilters}"
                        ItemsLayout="HorizontalList"
                        HeightRequest="42"
                        ItemSizingStrategy="MeasureFirstItem"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DirectoryViewModel+StatusFilter">
                    <Border Style="{StaticResource FilterChip}"
                            Margin="0,0,8,0">
                        <Border.Triggers>
                            <!-- Highlight the chip when VM says it's selected. -->
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsSelected}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DirectoryViewModel}}, Path=SelectStatusCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Label}"
                               Style="{StaticResource FilterChipLabel}"
                               TextColor="{StaticResource TextSecondary}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsSelected}"
                                             Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ============================== -->
        <!-- 4. SfDataGrid OR EmptyState    -->
        <!-- ============================== -->
        <Grid Grid.Row="3">

            <!-- The data grid is the default. -->
            <sfgrid:SfDataGrid x:Name="VisitorGrid"
                               ItemsSource="{Binding FilteredVisitors}"
                               AutoGenerateColumnsMode="None"
                               SelectionMode="Single"
                               ColumnWidthMode="Auto"
                               HeaderRowHeight="42"
                               RowHeight="64"
                               GridLinesVisibility="Horizontal"
                               Style="{StaticResource DirectoryGridStyle}"
                               CellTapped="OnCellTapped">

                <sfgrid:SfDataGrid.Columns>

                    <!-- Visitor: avatar + name + contact. -->
                    <sfgrid:DataGridTemplateColumn HeaderText="VISITOR"
                                                   MappingName="VisitorName"
                                                   Width="260">
                        <sfgrid:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Visitor">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Padding="14,0,0,0"
                                      VerticalOptions="Center">
                                    <controls:VisitorAvatar Grid.Column="0"
                                                            Initials="{Binding VisitorName}"
                                                            WidthRequest="34"
                                                            HeightRequest="34" />
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="1"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding VisitorName}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               TextColor="{StaticResource TextPrimary}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding ContactNumber}"
                                               FontFamily="OpenSansRegular"
                                               FontSize="10"
                                               TextColor="{StaticResource TextMuted}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </sfgrid:DataGridTemplateColumn.CellTemplate>
                    </sfgrid:DataGridTemplateColumn>

                    <!-- Host -->
                    <sfgrid:DataGridTemplateColumn HeaderText="HOST"
                                                   MappingName="Host"
                                                   Width="160">
                        <sfgrid:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Visitor">
                                <Label Text="{Binding Host}"
                                       VerticalOptions="Center"
                                       FontFamily="OpenSansRegular"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </DataTemplate>
                        </sfgrid:DataGridTemplateColumn.CellTemplate>
                    </sfgrid:DataGridTemplateColumn>

                    <!-- Purpose -->
                    <sfgrid:DataGridTemplateColumn HeaderText="PURPOSE"
                                                   MappingName="Purpose"
                                                   Width="140">
                        <sfgrid:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Visitor">
                                <Label Text="{Binding Purpose}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Start"
                                       FontFamily="OpenSansRegular"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </DataTemplate>
                        </sfgrid:DataGridTemplateColumn.CellTemplate>
                    </sfgrid:DataGridTemplateColumn>

                    <!-- Visit time (short label). -->
                    <sfgrid:DataGridTemplateColumn HeaderText="VISIT TIME"
                                                   MappingName="VisitTime"
                                                   Width="130"
                                                   Visible="{OnIdiom Phone=False, Default=True}">
                        <sfgrid:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Visitor">
                                <Label Text="{Binding VisitTime, Converter={StaticResource DateToShortLabelConverter}}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Start"
                                       FontFamily="OpenSansRegular"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </DataTemplate>
                        </sfgrid:DataGridTemplateColumn.CellTemplate>
                    </sfgrid:DataGridTemplateColumn>

                    <!-- Pass ID (hidden on phone). -->
                    <sfgrid:DataGridTemplateColumn HeaderText="PASS ID"
                                                   MappingName="PassId"
                                                   Width="100"
                                                   Visible="{OnIdiom Phone=False, Default=True}">
                        <sfgrid:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Visitor">
                                <Label Text="{Binding PassId}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Start"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="11"
                                       TextColor="{StaticResource Primary}" />
                            </DataTemplate>
                        </sfgrid:DataGridTemplateColumn.CellTemplate>
                    </sfgrid:DataGridTemplateColumn>

                    <!-- Status badge. -->
                    <sfgrid:DataGridTemplateColumn HeaderText="STATUS"
                                                   MappingName="Status"
                                                   Width="130">
                        <sfgrid:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Visitor">
                                <controls:VisitorStatusBadge Status="{Binding Status}"
                                                             VerticalOptions="Center"
                                                             HorizontalOptions="Start" />
                            </DataTemplate>
                        </sfgrid:DataGridTemplateColumn.CellTemplate>
                    </sfgrid:DataGridTemplateColumn>

                </sfgrid:SfDataGrid.Columns>

            </sfgrid:SfDataGrid>

            </Grid>

            <!--
                Empty state — shown when filters exclude every visitor.
            -->
            <controls:EmptyState IsVisible="{Binding HasNoResults}"
                                 Title="No visitors match your filters"
                                 Message="Try clearing the search box or selecting a different status." />

            <!-- ============================== -->
            <!-- 4b. Active Dossier preview      -->
            <!-- ============================== -->
            <Border Grid.Row="4"
                    Style="{StaticResource PanelCard}"
                    Padding="{OnIdiom Desktop='22,18,22,18', Phone='14,12,14,12'}"
                    IsVisible="{Binding HasSelectedVisitor}">

                <Grid ColumnDefinitions="{OnIdiom Desktop='Auto,*,Auto', Phone='*'}"
                      ColumnSpacing="{OnIdiom Desktop=22, Phone=0}"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="14">

                    <!-- Eyebrow + status badge row -->
                    <Grid Grid.Row="0" Grid.Column="0"
                          Grid.ColumnSpan="{OnIdiom Desktop=3, Phone=1}"
                          ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                            <Label Text="{x:Static controls:IconKeys.Badge}"
                                   FontFamily="MauiMaterialAssets"
                                   FontSize="18"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="ACTIVE DOSSIER"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="10"
                                       CharacterSpacing="1.4"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="Visitor Pass Details"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <controls:VisitorStatusBadge Grid.Column="1"
                                                      Status="{Binding SelectedVisitor.Status}"
                                                      VerticalOptions="Center" />
                    </Grid>

                    <!-- Identity column: avatar + name + host + purpose -->
                    <HorizontalStackLayout Grid.Row="1"
                                           Grid.Column="0"
                                           Spacing="14"
                                           VerticalOptions="Center">
                        <controls:VisitorAvatar Initials="{Binding SelectedVisitor.VisitorName}"
                                                WidthRequest="56"
                                                HeightRequest="56" />
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding SelectedVisitor.VisitorName}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding SelectedVisitor.Host}"
                                   FontFamily="OpenSansRegular"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding SelectedVisitor.Purpose}"
                                   FontFamily="OpenSansRegular"
                                   FontSize="10"
                                   TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- QR barcode + passcode caption -->
                    <VerticalStackLayout Grid.Row="{OnIdiom Desktop=1, Phone=2}"
                                         Grid.Column="{OnIdiom Desktop=1, Phone=0}"
                                         Spacing="6"
                                         HorizontalOptions="{OnIdiom Desktop=Center, Phone=Start}"
                                         VerticalOptions="Center">
                        <barcode:SfBarcodeGenerator Value="{Binding SelectedVisitor.PassId}"
                                                     BackgroundColor="{StaticResource Surface}"
                                                     ForegroundColor="{StaticResource TextPrimary}"
                                                     HeightRequest="110"
                                                     WidthRequest="110"
                                                     HorizontalOptions="Center">
                            <barcode:SfBarcodeGenerator.Symbology>
                                <barcode:QRCode />
                            </barcode:SfBarcodeGenerator.Symbology>
                        </barcode:SfBarcodeGenerator>
                        <Label Text="SECURE PASSCODE"
                               FontFamily="OpenSansSemibold"
                               FontSize="9"
                               CharacterSpacing="1.4"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding SelectedVisitor.PassId, StringFormat='{0}-CC'}"
                               FontFamily="OpenSansSemibold"
                               FontSize="11"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Summary tiles + action buttons -->
                    <VerticalStackLayout Grid.Row="{OnIdiom Desktop=1, Phone=3}"
                                         Grid.Column="{OnIdiom Desktop=2, Phone=0}"
                                         Spacing="10"
                                         HorizontalOptions="{OnIdiom Desktop=End, Phone=Fill}"
                                         VerticalOptions="Center">
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    Style="{StaticResource KpiCard}"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    Padding="10,8">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="PASS ID"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="8"
                                           CharacterSpacing="1.4"
                                           TextColor="{StaticResource TextMuted}" />
                                    <Label Text="{Binding SelectedVisitor.PassId}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="11"
                                           TextColor="{StaticResource Primary}"
                                           VerticalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1"
                                    Style="{StaticResource KpiCard}"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    Padding="10,8">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="CHECK-IN"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="8"
                                           CharacterSpacing="1.4"
                                           TextColor="{StaticResource TextMuted}" />
                                    <Label Text="{Binding SelectedVisitor.CheckInTimeDisplay}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="11"
                                           TextColor="{StaticResource TextPrimary}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Button Text="Open Full Pass Details"
                                Clicked="OnOpenFullPass"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                Padding="14,10"
                                CornerRadius="10"
                                HeightRequest="42" />

                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Fill">
                            <Button Text="Print Badge"
                                    Clicked="OnOpenFullPass"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="11"
                                    Padding="10,8"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    HorizontalOptions="Fill" />
                            <Button Text="Call Host"
                                    Clicked="OnOpenFullPass"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="11"
                                    Padding="10,8"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    HorizontalOptions="Fill" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ============================== -->
            <!-- 5. Footer (row count summary)  -->
            <!-- ============================== -->
            <Label Grid.Row="5"
                   Text="{Binding FilteredVisitors.Count, StringFormat='{0} visitor(s) shown'}"
                   TextColor="{StaticResource TextMuted}"
                   FontFamily="OpenSansRegular"
                   FontSize="11"
                   HorizontalOptions="Start" />

        </Grid>
    </Grid>
</ContentPage>
