<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VisitorPass.Views.RegisterVisitorView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:VisitorPass.Controls;assembly=VisitorPass"
    xmlns:vm="clr-namespace:VisitorPass.ViewModels;assembly=VisitorPass"
    x:DataType="vm:RegisterVisitorViewModel">

    <Border
        BackgroundColor="{StaticResource Surface}"
        Stroke="{StaticResource Border}"
        StrokeShape="RoundRectangle 16"
        Padding="0">

        <Grid RowDefinitions="Auto,Auto,Auto">

            <!-- HEADER -->

            <Grid
                Grid.Row="0"
                Padding="24,20"
                ColumnDefinitions="*,Auto">

                <HorizontalStackLayout
                    Spacing="12"
                    VerticalOptions="Center">

                    <Label
                        Text="{x:Static controls:IconKeys.Badge}"
                        FontFamily="MauiMaterialAssets"
                        FontSize="18"
                        TextColor="{StaticResource Primary}" />

                    <Label
                        Text="Visitor Information"
                        Style="{StaticResource SectionTitle}" />
                </HorizontalStackLayout>
            </Grid>

            <!-- CONTENT -->

            <ScrollView Grid.Row="1">

                <VerticalStackLayout
                    Padding="24,0,24,24"
                    Spacing="24">

                    <!-- VISITOR INFORMATION -->

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="18"
                        RowSpacing="18">

                        <!-- Visitor Name -->

                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="6">

                            <Label
                                Text="Visitor Name"
                                Style="{StaticResource SectionEyebrow}" />

                            <Border BackgroundColor="{StaticResource SurfaceAlt}"
                                    StrokeShape="RoundRectangle 4"
                                    HeightRequest="34"
                                    Padding="8,0">
                                <controls:SfEntry
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    Text="{Binding VisitorName}"
                                    Placeholder="Enter Visitor Name" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Contact Number -->

                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="6">

                            <Label
                                Text="Contact Number"
                                Style="{StaticResource SectionEyebrow}" />
                            <Border BackgroundColor="{StaticResource SurfaceAlt}"
                                    StrokeShape="RoundRectangle 4"
                                    HeightRequest="34"
                                    Padding="8,0">
                                <controls:SfEntry
                                    Placeholder="Enter Contact Number"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    Text="{Binding ContactNumber}"
                                    Keyboard="Telephone" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Host -->

                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="0"
                            Spacing="6">

                            <Label
                                Text="Host Employee Escort"
                                Style="{StaticResource SectionEyebrow}" />

                            <Picker
                                HeightRequest="42"
                                ItemsSource="{Binding HostOptions}"
                                SelectedItem="{Binding Host}" />
                        </VerticalStackLayout>

                        <!-- Purpose -->

                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="6">

                            <Label
                                Text="Visit Purpose"
                                Style="{StaticResource SectionEyebrow}" />

                            <Picker
                                HeightRequest="42"
                                ItemsSource="{Binding PurposeOptions}"
                                SelectedItem="{Binding Purpose}" />
                        </VerticalStackLayout>

                    </Grid>

                    <!-- VEHICLE -->

                    <VerticalStackLayout Spacing="8"
                                         HeightRequest="54">

                        <Label
                            Text="Vehicle Number Plate"
                            Style="{StaticResource SectionEyebrow}" />

                        <Border BackgroundColor="{StaticResource SurfaceAlt}"
                                StrokeShape="RoundRectangle 4"
                                HeightRequest="34"
                                Padding="8,0">
                            <controls:SfEntry
                                Placeholder="7XYZ88"
                                BackgroundColor="{StaticResource SurfaceAlt}"
                                Text="{Binding VehicleNumber}" />
                        </Border>

                    </VerticalStackLayout>


                    <!-- SCHEDULE HEADER -->

                    <Grid
                        ColumnDefinitions="*,Auto"
                        Margin="0,4,0,0">

                        <HorizontalStackLayout
                            Spacing="10"
                            VerticalOptions="Center">

                            <Label
                                Text="{x:Static controls:IconKeys.Event}"
                                FontFamily="MauiMaterialAssets"
                                TextColor="{StaticResource Primary}" />

                            <Label
                                Text="Schedule &amp; Authorization"
                                Style="{StaticResource SectionTitle}" />
                        </HorizontalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="Timezone: UTC-5 (EST)"
                            VerticalOptions="Center"
                            TextColor="{StaticResource TextSecondary}" />

                    </Grid>

                    <!-- SCHEDULE -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="Visit Date"
                                Style="{StaticResource SectionEyebrow}" />

                            <DatePicker
                                HeightRequest="42"
                                WidthRequest="180"
                                Date="{Binding VisitDate}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="6">

                            <Label
                                Text="Expected Time"
                                Style="{StaticResource SectionEyebrow}" />

                            <TimePicker
                                HeightRequest="62"
                                Time="{Binding VisitTime}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="2"
                            Spacing="6">

                            <Label
                                Text="Pass Duration"
                                Style="{StaticResource SectionEyebrow}" />

                            <Picker
                                HeightRequest="42"
                                WidthRequest="120"
                                ItemsSource="{Binding DurationPresets}"
                                SelectedItem="{Binding ExpectedDurationMinutes}" />
                        </VerticalStackLayout>

                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <!-- FOOTER -->

            <Grid
                Grid.Row="2"
                BackgroundColor="{StaticResource SurfaceAlt}"
                Padding="24,16"
                ColumnDefinitions="*,Auto,Auto">

                <HorizontalStackLayout
                    Spacing="8"
                    VerticalOptions="Center">

                    <Label
                        Text="{x:Static controls:IconKeys.Lock}"
                        FontFamily="MauiMaterialAssets"
                        TextColor="{StaticResource StatusCheckedIn}" />

                    <Label
                        Text="Encrypted badge issuance"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="12" />
                </HorizontalStackLayout>

                <Button
                    Grid.Column="1"
                    HeightRequest="48"
                    WidthRequest="80"
                    Text="Cancel"
                    Command="{Binding RequestCancelCommand}"
                    Style="{StaticResource ActionSecondaryButton}" />

                <Button
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    HeightRequest="48"
                    WidthRequest="160"
                    Text="Generate Visitor Pass"
                    Command="{Binding SubmitCommand}"
                    Style="{StaticResource ActionPrimaryButton}" />

            </Grid>
        </Grid>
    </Border>
</ContentView>