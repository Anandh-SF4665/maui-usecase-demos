<?xml version="1.0" encoding="utf-8" ?>
<!--
    Reusable ContentView carrying the registration form layout.

    Wrapped by:
      - Views/RegisterVisitorPage.xaml  (ContentPage host, for any
        future Navigation.PushModalAsync slide-up use).
      - DashboardPage.xaml              (the two OnIdiom containers
        in VP-073 — SfPopup on desktop/tablet, phone overlay on
        phone). Both containers instantiate this view directly so
        the form XAML exists exactly once.

    Step 1 — Visitor info (name, host Picker, purpose Picker,
             contact, vehicle).
    Step 2 — Schedule (DatePicker, TimePicker, duration Picker).
    Step 3 — Pass-generated confirmation.

    Why Picker / DatePicker / TimePicker instead of Syncfusion
    SfComboBox / SfDateTimePicker:
      Syncfusion.Maui.Core 33.2.15 and Syncfusion.Maui.Toolkit
      1.0.11 don't ship those controls in this version. The
      in-repo reference pattern (VisitorDetailsPage timeline +
      pass-code label) matches this approach.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VisitorPass.ViewModels;assembly=VisitorPass"
             x:Class="VisitorPass.Views.RegisterVisitorView"
             x:DataType="vm:RegisterVisitorViewModel">

    <Border BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource Border}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="20">
        <Grid RowSpacing="14"
              RowDefinitions="Auto,*,Auto">

            <!-- ====================================================
                 Header — eyebrow + step heading
                 ==================================================== -->
            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="REGISTRATION"
                       FontFamily="OpenSansSemibold"
                       FontSize="11"
                       CharacterSpacing="1.5"
                       TextColor="{StaticResource Primary}" />
                <Label Text="{Binding StepHeading}"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>

            <!-- ====================================================
                 Step body
                 ==================================================== -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="14">

                    <!-- Error banner (only visible when ValidationErrors has rows). -->
                    <Border BackgroundColor="{StaticResource StatusCancelledBg}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0"
                            Padding="12"
                            IsVisible="{Binding ValidationErrors.Count, Converter={StaticResource IntToBoolConverter}}">
                        <CollectionView ItemsSource="{Binding ValidationErrors}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding}"
                                           TextColor="{StaticResource StatusCancelledBrush}"
                                           FontFamily="OpenSansRegular"
                                           FontSize="11" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <!-- Step 1 — Visitor info. -->
                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}">
                        <Label Text="Visitor Information" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Visitor Name" Style="{StaticResource SectionEyebrow}" />
                            <Entry Text="{Binding VisitorName}" Placeholder="e.g. Anu Kumar" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Host" Style="{StaticResource SectionEyebrow}" />
                            <Picker Title="Select host"
                                    ItemsSource="{Binding HostOptions}"
                                    SelectedItem="{Binding Host}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Purpose" Style="{StaticResource SectionEyebrow}" />
                            <Picker Title="Select purpose"
                                    ItemsSource="{Binding PurposeOptions}"
                                    SelectedItem="{Binding Purpose}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Contact Number" Style="{StaticResource SectionEyebrow}" />
                            <Entry Text="{Binding ContactNumber}" Placeholder="e.g. +91 98765 43210"
                                   Keyboard="Telephone" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Vehicle Number (optional)" Style="{StaticResource SectionEyebrow}" />
                            <Entry Text="{Binding VehicleNumber}" Placeholder="e.g. TN-01-AB-1234" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Step 2 — Schedule. -->
                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}">
                        <Label Text="Schedule" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Visit Date" Style="{StaticResource SectionEyebrow}" />
                            <DatePicker Date="{Binding VisitDate}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Visit Time" Style="{StaticResource SectionEyebrow}" />
                            <TimePicker Time="{Binding VisitTime}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Expected Duration" Style="{StaticResource SectionEyebrow}" />
                            <Picker Title="Select duration"
                                    ItemsSource="{Binding DurationPresets}"
                                    SelectedItem="{Binding ExpectedDurationMinutes}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Step 3 — Pass generated. -->
                    <VerticalStackLayout Spacing="14"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Margin="0,20,0,0"
                                         IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}">
                        <Label Text="PASS GENERATED"
                               FontFamily="OpenSansSemibold"
                               FontSize="12"
                               CharacterSpacing="2"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource StatusCheckedIn}" />
                        <Label Text="{Binding CreatedVisitor.PassId}"
                               FontFamily="OpenSansSemibold"
                               FontSize="22"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="The visitor has been added to the directory and their pass is ready."
                               FontFamily="OpenSansRegular"
                               FontSize="11"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ====================================================
                 Action row — Next / Back / Generate / Cancel
                 ==================================================== -->
            <Grid Grid.Row="2" ColumnSpacing="10"
                  ColumnDefinitions="{OnIdiom Desktop='*,*', Phone='Auto,*,*'}">

                <Button Grid.Column="0"
                        Text="Cancel"
                        Style="{StaticResource ActionSecondaryButton}"
                        Command="{Binding RequestCancelCommand}"
                        HorizontalOptions="{OnIdiom Desktop=Start, Phone=Fill}" />

                <Button Grid.Column="1"
                        Text="Back"
                        Style="{StaticResource ActionSecondaryButton}"
                        IsVisible="{Binding CurrentStep, Converter={StaticResource IntGreaterThanConverter}, ConverterParameter=1}"
                        Command="{Binding BackFromStep2Command}"
                        HorizontalOptions="{OnIdiom Desktop=End, Phone=Fill}" />

                <Button Grid.Column="2"
                        Text="Next"
                        Style="{StaticResource ActionPrimaryButton}"
                        IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                        Command="{Binding NextFromStep1Command}"
                        HorizontalOptions="{OnIdiom Desktop=End, Phone=Fill}" />

                <Button Grid.Column="2"
                        Text="Generate Pass"
                        Style="{StaticResource ActionPrimaryButton}"
                        IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                        Command="{Binding SubmitCommand}"
                        HorizontalOptions="{OnIdiom Desktop=End, Phone=Fill}" />

            </Grid>
        </Grid>
    </Border>
</ContentView>
